# Copy this file to .env and fill it in, or just run scripts/install.sh
# (Linux/macOS/WSL) or scripts/install.ps1 (Windows) which does it for you.
# .env is git-ignored - never commit it.

# ---- Required -------------------------------------------------------------

# Path to your LEGO Universe 1.10.64 client folder (the folder that contains
# legouniverse.exe, res/ and locale/). Absolute path or relative to this repo.
# Windows example: C:/Games/LEGO Universe   (use forward slashes)
CLIENT_PATH=./client

# The IP address game clients will connect to.
#   localhost        -> only you, on this PC
#   192.168.x.x      -> you + anyone on your home network (recommended)
#   your public IP   -> friends over the internet (needs port forwarding)
EXTERNAL_IP=localhost

# Database password (any long random string).
MARIADB_PASSWORD=change-me-to-something-long-and-random

# Secret used to sign Nexus Dashboard login sessions (any long random string).
ACCOUNT_MANAGER_SECRET=change-me-to-another-long-random-string

# Password the internal servers use to talk to MasterServer.
MASTER_PASSWORD=change-me-too

# Run the Nexus Dashboard website. Requires an UNPACKED client
# (res/brickdb.zip + res/brickprimitives). Install empties this automatically
# for packed clients; set it back to "dashboard" once you unpack the client.
COMPOSE_PROFILES=dashboard

# ---- Optional -------------------------------------------------------------

MARIADB_USER=darkflame
MARIADB_DATABASE=darkflame

# Port for the Nexus Dashboard website (http://<this-pc>:8000)
DASHBOARD_PORT=8000

# 171022 = original LEGO Universe client. Use 171023 for a Darkflame Universe client.
CLIENT_NET_VERSION=171022

# Play keys. Defaults: off (anyone who registers can play).
#   To require play keys: DONT_USE_KEYS=0 and ND_REQUIRE_PLAY_KEY=1
DONT_USE_KEYS=1
ND_REQUIRE_PLAY_KEY=

# Allow sign-ups on the dashboard. Leave EMPTY to disable registration.
ND_ENABLE_REGISTER=1

# Pin image versions if you want (default: latest)
DLU_IMAGE_TAG=latest
ND_IMAGE_TAG=latest
